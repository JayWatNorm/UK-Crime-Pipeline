# Copy to .env and fill in real values. .env itself is gitignored.
# Entirely separate from Comfort Compass's .env — different DB, different container.
#
# This is the single source of truth for database connection details --
# read by ingestion/ingest.py (via python-dotenv) and by dbt (via
# run-dbt.ps1, which loads this file before invoking dbt, since dbt can't
# read .env itself). Values below are the defaults for the repo's own
# bundled Postgres from docker-compose.yml; point them somewhere else and
# everything follows, with no other file needing to change.

DB_NAME=crime_data
DB_USER=crime_pipeline
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5433

# Airflow's own metadata DB (separate Postgres instance, Phase 5) --
# unrelated to the app database above, just needs its own credentials.
AIRFLOW_DB_NAME=airflow_metadata
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=changeme
